# ---------------------------------------------------------------------------
# Cadre — environment template
# Copy to `.env` (repo root). NEVER commit real secrets.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
# NODE_ENV is managed by Next.js and the CLIs — do not set it here.
APP_URL=http://localhost:3000
# Branding is centralised in packages/config/src/brand.ts; this overrides the display name.
APP_NAME="Cadre"
LOG_LEVEL=info

# DEMO_MODE=true swaps every paid provider (LLM, STT, TTS, evaluation) for
# deterministic local implementations so the product can be shown with no API keys.
DEMO_MODE=true

# --- AI Sales Agent ----------------------------------------------------------
# website: research reads the lead's own public website (robots.txt respected, SSRF-protected)
# none:    research uses the lead record only
RESEARCH_PROVIDER=website

# Lead discovery ("Find leads"):
# agent:   Cadre's own prospecting agent — searches OpenStreetMap and Wikidata (free, open
#          data, no keys), reads public business directories, and visits each company's own
#          website for contact details (robots.txt respected, SSRF-protected)
# samples: fictional sample companies (demos and tests only)
# off:     disabled
DISCOVERY_PROVIDER=agent
# Optional: also let Claude's web search suggest companies (AI_PROVIDER=anthropic only)
DISCOVERY_CLAUDE_WEB_SEARCH=false

# --- Database ---------------------------------------------------------------
# docker compose:      postgresql://interviewer:interviewer@localhost:5432/interviewer
# pnpm dev:db (no docker): postgresql://postgres:postgres@localhost:54329/interviewer
DATABASE_URL=postgresql://interviewer:interviewer@localhost:5432/interviewer
DATABASE_POOL_MAX=10
# Integration/E2E tests use TEST_DATABASE_URL, or DATABASE_URL with "_test" appended to the
# database name. They TRUNCATE every table, so the name must end in "_test".
# TEST_DATABASE_URL=

# --- Authentication ---------------------------------------------------------
# Generate with: openssl rand -base64 48
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars
AUTH_REQUIRE_EMAIL_VERIFICATION=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated list of extra trusted origins (APP_URL is always trusted)
AUTH_TRUSTED_ORIGINS=

# Secret used to sign candidate interview-session credentials (falls back to AUTH_SECRET)
CANDIDATE_SESSION_SECRET=

# --- AI (LLM) ---------------------------------------------------------------
# anthropic | openai | ollama | mock   (mock is forced when DEMO_MODE=true)
# ollama: a free local model on this machine — install Ollama, run `ollama pull qwen2.5:7b-instruct`,
#         set DEMO_MODE=false. AI_BASE_URL defaults to http://localhost:11434/v1; no AI_API_KEY needed.
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-5-5
# Optional cheaper/faster model used for the per-turn interviewer loop
AI_FAST_MODEL=
AI_API_KEY=
# Optional base URL for OpenAI-compatible gateways
AI_BASE_URL=
AI_TIMEOUT_MS=45000
AI_MAX_RETRIES=2

# --- Speech -----------------------------------------------------------------
# STT: openai | deepgram | browser | mock      TTS: openai | elevenlabs | browser | mock
# "browser" uses the candidate's browser speech APIs (no server cost, Chrome/Edge/Safari).
STT_PROVIDER=browser
STT_API_KEY=
STT_MODEL=
TTS_PROVIDER=browser
TTS_API_KEY=
TTS_MODEL=

# --- Storage ----------------------------------------------------------------
# local | s3 | r2 | supabase   (r2/supabase use the S3-compatible API)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=.data/uploads
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=false

# --- Queue / background jobs -------------------------------------------------
# postgres (default, no extra infra) — jobs live in the background_job table.
QUEUE_DRIVER=postgres
# Run the job worker inside the web process (convenient for local dev; use apps/worker in production)
QUEUE_INLINE_WORKER=true
WORKER_CONCURRENCY=4
REDIS_URL=redis://localhost:6379

# --- Email ------------------------------------------------------------------
# console | resend | smtp
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM="AI Interviewer <no-reply@example.com>"
SMTP_URL=

# --- Code execution (coding questions) --------------------------------------
# disabled | piston
CODE_EXECUTION_PROVIDER=disabled
CODE_EXECUTION_URL=

# --- Development seed -------------------------------------------------------
# Password for the seeded local test users (admin@nova.test, recruiter@nova.test, �). Dev only.
SEED_USER_PASSWORD=NovaDemo!2026

# --- Observability ----------------------------------------------------------
SENTRY_DSN=
