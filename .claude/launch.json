{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "corepack",
      "runtimeArgs": ["pnpm", "--dir", "apps/web", "dev"],
      "port": 3000
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "corepack",
      "runtimeArgs": ["pnpm", "--dir", "apps/web", "exec", "next", "start", "--port", "3001"],
      "env": { "AUTH_TRUSTED_ORIGINS": "http://localhost:3001" },
      "port": 3001
    }
  ]
}
