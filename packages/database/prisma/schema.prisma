// Cadre — relational data model (platform + AI Interviewer + AI Sales Agent).
// Conventions:
//   * cuid string ids, createdAt/updatedAt on mutable entities
//   * soft deletion (deletedAt) on important business entities
//   * candidate-facing data never references server-only fields directly
//   * JSON columns are validated by zod schemas in @repo/validation / @repo/ai before writes

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

