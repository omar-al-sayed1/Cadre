{
  "name": "cadre",
  "private": true,
  "description": "Cadre: build your AI workforce. A multi-product SaaS platform of AI employees (AI Interviewer, AI Sales Agent).",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @repo/web dev",
    "dev:worker": "pnpm --filter @repo/worker dev",
    "dev:db": "node scripts/dev-db.mjs",
    "build": "pnpm --filter @repo/web build",
    "start": "pnpm --filter @repo/web start",
    "start:worker": "pnpm --filter @repo/worker start",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --project integration",
    "test:e2e": "pnpm --filter @repo/web test:e2e",
    "db:generate": "pnpm --filter @repo/database db:generate",
    "db:migrate": "pnpm --filter @repo/database db:migrate",
    "db:migrate:deploy": "pnpm --filter @repo/database db:migrate:deploy",
    "db:migrate:create": "pnpm --filter @repo/database db:migrate:create",
    "db:seed": "pnpm --filter @repo/database db:seed",
    "db:reset": "pnpm --filter @repo/database db:reset",
    "db:studio": "pnpm --filter @repo/database db:studio",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "setup:local-ai": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-local-ai.ps1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.1",
    "@vitest/coverage-v8": "5.0.3",
    "dotenv": "17.4.2",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.4.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.3"
  }
}
